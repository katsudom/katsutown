{
  "name": "katsutown",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Katsudom Town - a pixel-RPG portfolio for Dominic Pham",
  "scripts": {
    "assets": "node tools/generate-assets.mjs",
    "maps": "node tools/generate-maps.mjs",
    "prebuild": "npm run assets",
    "predev": "npm run assets",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,html,md}\"",
    "dev:serve": "vite"
  },
  "dependencies": {
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5"
  }
}
